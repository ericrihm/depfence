{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depfence.dev/schemas/depfence.sealed-intake/v1.json",
  "type": "object",
  "required": ["schema_version", "intake_id", "created_at", "source_id", "source_host", "commit", "tree_sha256", "status", "ingestion_policy", "counts", "suffix_counts", "analysis", "warning_codes", "approved", "materialized_on_host"],
  "properties": {
    "schema_version": {"const": "depfence.sealed-intake/v1"},
    "intake_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_id": {"type": "string", "pattern": "^source-hmac-sha256:[0-9a-f]{64}$"},
    "source_host": {"type": "string", "minLength": 1, "maxLength": 253},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "UNPROVEN", "INDETERMINATE"]},
    "ingestion_policy": {"enum": ["allow", "quarantine", "confirm", "unproven"]},
    "counts": {
      "type": "object",
      "required": ["files", "bytes", "regular_files", "symlinks", "submodules", "non_regular"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "regular_files": {"type": "integer", "minimum": 0},
        "symlinks": {"type": "integer", "minimum": 0},
        "submodules": {"type": "integer", "minimum": 0},
        "non_regular": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "suffix_counts": {
      "type": "object",
      "propertyNames": {"pattern": "^(?:\\.[a-z0-9]{1,16}|<none>)$"},
      "additionalProperties": {"type": "integer", "minimum": 0},
      "maxProperties": 256
    },
    "analysis": {
      "type": "object",
      "required": ["complete", "candidate_count", "analyzed_count", "analyzed_bytes", "coverage_by_suffix", "findings", "limitations", "toolchain", "rule_version", "coverage_units", "presentation_mechanisms_inspected"],
      "properties": {
        "complete": {"type": "boolean"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "analyzed_count": {"type": "integer", "minimum": 0},
        "analyzed_bytes": {"type": "integer", "minimum": 0},
        "rule_version": {"const": "2026-08-17"},
        "coverage_units": {"type": "object", "required": ["artifacts"], "properties": {"artifacts": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "presentation_mechanisms_inspected": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "coverage_by_suffix": {
          "type": "object",
          "propertyNames": {"pattern": "^\\.[a-z0-9]{1,16}$"},
          "additionalProperties": {
            "type": "object",
            "required": ["total", "analyzed", "incomplete"],
            "properties": {
              "total": {"type": "integer", "minimum": 0},
              "analyzed": {"type": "integer", "minimum": 0},
              "incomplete": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "maxProperties": 32
        },
        "findings": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["artifact_id", "suffix", "rule_id", "severity", "confidence", "evidence_class", "rule_version", "artifact_type", "carrier_type"],
            "properties": {
              "artifact_id": {"type": "string", "pattern": "^sealed-artifact-sha256:[0-9a-f]{64}$"},
              "suffix": {"type": "string", "pattern": "^\\.[a-z0-9]{1,16}$"},
              "rule_id": {"enum": ["DF-FONT-001", "DF-FONT-002", "DF-FONT-003", "DF-FONT-004", "DF-FONT-005", "DF-WEB-001", "DF-DOCX-001", "DF-DOCX-002", "DF-PDF-001", "DF-PDF-002", "DF-PDF-003"]},
              "rule_version": {"const": "2026-08-17"},
              "artifact_type": {"enum": ["otf", "ttf", "ttc", "woff", "woff2", "pdf", "docx", "html", "htm", "css"]},
              "carrier_type": {"const": "git_blob"},
              "severity": {"enum": ["low", "medium", "high"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_class": {"enum": ["sparse_font_cluster", "cmap_subtable_conflict", "structural_correlation", "degenerate_cmap", "zero_width_stealth", "missing_layout_tables", "active_content", "incremental_save", "hidden_document_content", "hidden_text_topology"]}
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["artifact_id", "suffix", "code"],
            "properties": {
              "artifact_id": {"type": "string", "pattern": "^sealed-artifact-sha256:[0-9a-f]{64}$"},
              "suffix": {"type": "string", "pattern": "^\\.[a-z0-9]{1,16}$"},
              "code": {"enum": ["artifact_budget_exceeded", "artifact_size_exceeded", "analysis_byte_budget_exceeded", "blob_read_failed", "deep_analysis_required", "font_sanitizer_unavailable", "font_sanitization_failed", "font_collection_limit", "font_collection_unsupported", "font_collection_decompression_failed"]}
            },
            "additionalProperties": false
          }
        },
        "toolchain": {
          "type": "object",
          "required": ["depfence"],
          "properties": {"depfence": {"type": "string", "minLength": 1, "maxLength": 64}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "warning_codes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
    "approved": {"const": false},
    "materialized_on_host": {"const": false}
  },
  "additionalProperties": false
}
