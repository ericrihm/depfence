{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depfence.dev/schemas/depfence.triage/v1.json",
  "type": "object",
  "required": ["schema_version", "journal_id", "sequence", "created_at", "project_id", "finding_id", "decision", "reason", "evidence_ids", "previous_hmac", "record_hmac"],
  "properties": {
    "schema_version": {"const": "depfence.triage/v1"},
    "journal_id": {"type": "string", "pattern": "^triage_journal-hmac-sha256:[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "pattern": "^project-hmac-sha256:[0-9a-f]{64}$"},
    "finding_id": {"type": ["string", "null"], "pattern": "^df-[0-9a-f]{20}$"},
    "decision": {"enum": ["unreviewed", "confirmed", "likely", "false_positive", "accepted_risk", "needs_context"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 240},
    "evidence_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}},
    "previous_hmac": {"type": ["string", "null"], "pattern": "^triage_record-hmac-sha256:[0-9a-f]{64}$"},
    "record_hmac": {"type": "string", "pattern": "^triage_record-hmac-sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
