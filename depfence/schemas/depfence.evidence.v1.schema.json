{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depfence.dev/schemas/depfence.evidence/v1.json",
  "type": "object",
  "required": ["schema_version", "evidence_id", "created_at", "project_id", "classification", "status", "source_digest", "coverage", "findings"],
  "properties": {
    "schema_version": {"const": "depfence.evidence/v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "pattern": "^project-hmac-sha256:[0-9a-f]{64}$"},
    "classification": {"const": "redacted-private"},
    "status": {"enum": ["PASS", "FAIL", "INDETERMINATE", "UNPROVEN"]},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "coverage": {
      "type": "object",
      "required": ["complete", "scanners", "errors", "scanner_errors"],
      "properties": {
        "complete": {"type": "boolean"},
        "scanners": {"type": "object", "additionalProperties": {"enum": ["PASS", "FAIL", "INDETERMINATE", "UNPROVEN"]}},
        "errors": {"type": "array", "items": {"type": "string", "maxLength": 240}},
        "scanner_errors": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 240}}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "severity", "title", "summary"],
        "properties": {
          "id": {"type": "string", "pattern": "^df-[0-9a-f]{20}$"},
          "rule": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "title": {"type": "string", "maxLength": 160},
          "summary": {"type": "string", "maxLength": 240}
          ,"snippet": {"type": "string", "maxLength": 320}
          ,"snippet_status": {"enum": ["available", "redacted", "truncated", "unavailable"]}
          ,"snippet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ,"metadata_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ,"evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ,"location": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["file", "config", "log", "unknown"]},
              "id": {"type": "string", "pattern": "^location-hmac-sha256:[0-9a-f]{64}$"},
              "line": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
          ,"confidence": {"type": "number", "minimum": 0, "maximum": 1}
          ,"evidence_class": {"enum": ["static_analysis", "coverage_failure", "supply_chain", "provenance", "secret", "policy", "other"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}


