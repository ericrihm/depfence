{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depfence.dev/schemas/depfence.triage-plan/v1.json",
  "type": "object",
  "required": ["schema_version", "mode", "status", "project_id", "decision", "reason", "finding_id", "evidence_ids", "would_append"],
  "properties": {
    "schema_version": {"const": "depfence.triage-plan/v1"},
    "mode": {"const": "dry-run"},
    "status": {"const": "PASS"},
    "project_id": {"type": "string", "pattern": "^project-hmac-sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["unreviewed", "confirmed", "likely", "false_positive", "accepted_risk", "needs_context"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 240},
    "finding_id": {"type": ["string", "null"], "pattern": "^df-[0-9a-f]{20}$"},
    "evidence_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}},
    "would_append": {"const": true}
  },
  "additionalProperties": false
}
